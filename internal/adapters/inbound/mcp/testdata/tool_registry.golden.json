    "description": "List the scorecards whose current grade matches, ordered by scorecardId ascending, one page at a time: grade is required (A, B, C, D or PROVISIONAL), the window filter (7d or 30d), the page size (1..500, default 100) and the cursor are optional. Pass the returned nextCursor as after to get the next page; it is absent on the last page. Read-only; a bad grade, window or limit fails with validation-failed.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "description": "the optional cursor returned as nextCursor by the previous page; omitted means the first page",
          "type": "string"
        },
        "grade": {
          "description": "the current grade to list: A, B, C, D or PROVISIONAL (required)",
          "type": "string"
        },
        "limit": {
          "description": "optional page size, 1..500; omitted or 0 means the default page size of 100",
          "type": "integer"
        },
        "window": {
          "description": "optional window filter, 7d or 30d; omitted means both windows",
          "type": "string"
        }
      },
